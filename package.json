{
  "name": "argostos",
  "version": "0.1.0",
  "private": true,
  "description": "Argostos, an HTML5 game in prototype: a glass worm swims through the falling sand of Sandopia and hunts the machines of a mining company.",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "frame-time": "node scripts/frame-time.ts",
    "takedown-shots": "node scripts/takedown-shots.ts",
    "session-code": "node scripts/session-code.ts",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "chrome-launcher": "1.2.3",
    "eslint": "10.15.0",
    "eslint-plugin-oxlint": "1.94.0",
    "lighthouse": "13.6.0",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
